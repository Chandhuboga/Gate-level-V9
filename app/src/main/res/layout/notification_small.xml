<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_frame_bg"
    android:padding="16dp">

    <ImageView android:id="@+id/corner_tl" android:layout_width="14dp" android:layout_height="14dp"
        android:layout_alignParentTop="true" android:layout_alignParentStart="true"
        android:src="@drawable/ic_corner_bracket" />
    <ImageView android:id="@+id/corner_br" android:layout_width="14dp" android:layout_height="14dp"
        android:layout_alignParentBottom="true" android:layout_alignParentEnd="true"
        android:rotation="180" android:src="@drawable/ic_corner_bracket" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toStartOf="@+id/spacer"
        android:orientation="vertical">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="!"
                android:textColor="#BDF3FF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@android:color/transparent" />
            <TextView
                android:id="@+id/notif_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="NOTIFICATION"
                android:textColor="#D9FAFF"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SYSTEM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/notif_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Message"
            android:textColor="#7FE3FF"
            android:textSize="12sp" />
    </LinearLayout>

    <View android:id="@+id/spacer" android:layout_width="1dp" android:layout_height="1dp" android:layout_alignParentEnd="true" />
</RelativeLayout>
